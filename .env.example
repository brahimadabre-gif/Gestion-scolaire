# ── Gestion Scolaire Pro Plus — Variables d'environnement ────
# Base de données (SQLite en développement)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Secret de signature des sessions JWT (min. 32 caractères, à générer : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-de-32-caracteres-minimum

# Clé API pour l'intégration avec le logiciel Gestion Scolaire Pro Plus
# (envoyée par le logiciel dans l'en-tête x-api-key — JAMAIS exposée au frontend)
SOFTWARE_API_KEY=changez-moi-aussi

# Service e-mail (à configurer avant la mise en production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Gestion Scolaire Pro Plus <noreply@example.com>"

# Passerelles de paiement (à intégrer : Webhook PSP)
# PSP_ORANGE_MONEY_KEY=
# PSP_MTN_MOMO_KEY=
# PSP_WAVE_KEY=
# PSP_STRIPE_KEY=
